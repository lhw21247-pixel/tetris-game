{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "构建俄罗斯方块",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\tetris.cpp",
                "-o",
                "tetris.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 g++ 构建俄罗斯方块"
        }
    ]
}
